{
  "name": "columnkit",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "SysAdminDoc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SysAdminDoc/ColumnKit.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "columnkit.even",
        "title": "%command.even.title%",
        "category": "%category%",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "columnkit.pickColumns",
        "title": "%command.pickColumns.title%",
        "category": "%category%",
        "icon": "$(layout)"
      },
      {
        "command": "columnkit.undoLayout",
        "title": "%command.undoLayout.title%",
        "category": "%category%",
        "icon": "$(discard)"
      },
      {
        "command": "columnkit.pinColumn",
        "title": "%command.pinColumn.title%",
        "category": "%category%",
        "icon": "$(pin)"
      },
      {
        "command": "columnkit.evenSplit",
        "title": "%command.evenSplit.title%",
        "category": "%category%",
        "icon": "$(split-vertical)"
      },
      {
        "command": "columnkit.setColumnWidth",
        "title": "%command.setColumnWidth.title%",
        "category": "%category%",
        "icon": "$(percentage)"
      },
      {
        "command": "columnkit.columns2",
        "title": "%command.columns2.title%",
        "category": "%category%"
      },
      {
        "command": "columnkit.columns3",
        "title": "%command.columns3.title%",
        "category": "%category%"
      },
      {
        "command": "columnkit.columns4",
        "title": "%command.columns4.title%",
        "category": "%category%"
      },
      {
        "command": "columnkit.columns5",
        "title": "%command.columns5.title%",
        "category": "%category%"
      },
      {
        "command": "columnkit.columns6",
        "title": "%command.columns6.title%",
        "category": "%category%"
      },
      {
        "command": "columnkit.columns8",
        "title": "%command.columns8.title%",
        "category": "%category%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "columnkit.even",
          "group": "navigation@99",
          "when": "config.columnkit.showEditorTitleButton"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "columnkit.statusBarPresets": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "default": [],
          "description": "%config.statusBarPresets%"
        },
        "columnkit.statusBarAlignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "left",
          "description": "%config.statusBarAlignment%"
        },
        "columnkit.showEditorTitleButton": {
          "type": "boolean",
          "default": false,
          "description": "%config.showEditorTitleButton%"
        },
        "columnkit.autoCorrect": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoCorrect%"
        },
        "columnkit.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "%config.checkForUpdates%"
        },
        "columnkit.rememberLayout": {
          "type": "boolean",
          "default": false,
          "description": "%config.rememberLayout%"
        },
        "columnkit.remainderStrategy": {
          "type": "string",
          "enum": [
            "even",
            "proportional"
          ],
          "default": "even",
          "description": "%config.remainderStrategy%"
        },
        "columnkit.watchWhileIdle": {
          "type": "boolean",
          "default": false,
          "description": "%config.watchWhileIdle%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist')\"",
    "package": "npm run clean && vsce package --out dist/ && node scripts/checksums.js",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5",
    "diff": ">=8.0.3"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "icon": "resources/icon.png",
  "extensionKind": [
    "ui"
  ]
}
